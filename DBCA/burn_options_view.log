# psql_command.sh
#    --nologfile
#    --command "
CREATE TABLE burn_options_average_last_burn_year AS
    SELECT
        data.dbca_burn_options_program_dbca_007_20260527.*,
        ST_Area(data.dbca_burn_options_program_dbca_007_20260527.geom::geography) AS area,
        ROUND( SUM(st_area(dbca_fire_history_dbca_060_burn_options_view_dissolve.geom) * EXTRACT (YEAR FROM fih_date1 + 184)) / SUM(st_area(dbca_fire_history_dbca_060_burn_options_view_dissolve.geom)) ) AS average_year
    FROM data.dbca_burn_options_program_dbca_007_20260527
    JOIN dbca_fire_history_dbca_060_burn_options_view_dissolve
    ON  ARRAY[data.dbca_burn_options_program_dbca_007_20260527.burnid] <@ dbca_fire_history_dbca_060_burn_options_view_dissolve.burnid
    WHERE fih_date1 IS NOT NULL
    GROUP BY data.dbca_burn_options_program_dbca_007_20260527.object_id"
